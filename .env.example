# Application
APP_ENV=development

# Backend
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:local-development-only@127.0.0.1:5432/leadhive_v2
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SESSION_HOURS=12
EXTERNAL_API_TIMEOUT_SECONDS=20
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_BYTES=2000000
SCRAPER_USER_AGENT=LeadHiveBot/2.0 (+https://leadhive.work/bot)

# External services (Phase 2+)
SERPER_API_KEY=
GOOGLE_PLACES_API_KEY=

# AI (Phase 4+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_TIMEOUT_SECONDS=45
AI_MAX_WEBSITE_CHARS=30000

# Background worker
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# Approved email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LeadHive
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_MAX_EMAILS_PER_DAY=100
SMTP_MINIMUM_INTERVAL_SECONDS=60

# Secret used to encrypt SMTP passwords stored through the admin screen.
# Generate once with: backend/.venv/Scripts/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
