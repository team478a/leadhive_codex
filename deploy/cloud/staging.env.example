# Example only: set these individually in the platform secret/config UI.
# DATABASE_URL: a NEW staging PostgreSQL private connection string.
# SETTINGS_ENCRYPTION_KEY: a NEW stable Fernet key, stored as a secret.
# CORS_ORIGINS and PUBLIC_APP_URL: the exact HTTPS web origin, no trailing slash.
# API_HOST: backend private DNS hostname (web service only, without protocol/port).
COOKIE_SECURE=true
AGENT_FEATURES_ENABLED=false
OUTBOUND_ENABLED=false
WORKER_PAUSED=true
HUMAN_APPROVED_EMAIL_ENABLED=false
HUMAN_APPROVED_FORM_ENABLED=false
LEGACY_FORM_DELIVERY_ENABLED=false
EMAIL_FEEDBACK_WEBHOOK_ENABLED=false
FORM_ADAPTER_PREPARATION_ENABLED=false
CF7_CANDIDATE_PREPARATION_ENABLED=false
FORM_ADAPTER_LAB_EXECUTION_ENABLED=false
FORM_CONFIRMATION_LAB_ENABLED=false
